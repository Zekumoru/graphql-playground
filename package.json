{
  "name": "graphql-playground",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch --include \"src/modules/**/*.graphql\" src/server.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "client": "pnpm codegen && tsx src/client.ts",
    "build": "rimraf dist && pnpm codegen && tsc && cpy \"modules/**/*.graphql\" ../dist/ --cwd=src --base=cwd"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {},
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "type": "module",
  "dependencies": {
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.2.4",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/node": "^24.13.4",
    "cpy-cli": "7.0.0",
    "rimraf": "6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
